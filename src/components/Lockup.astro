---
import { site } from '../config/site';

interface Props {
	href?: string;
	logo?: boolean;
}

const { href, logo = false } = Astro.props;
const Tag = href ? 'a' : 'span';
const mark = logo ? site.logo : null;
---

<Tag class={mark ? 'lockup lockup--logo' : 'lockup'} href={href}>
	{
		mark ? (
			<img src={mark.src} width={mark.width} height={mark.height} alt={site.name} decoding="async" />
		) : (
			<span class="lockup__name">{site.name}</span>
		)
	}
	<span class="lockup__div" aria-hidden="true"></span>
	<span class="lockup__slogan">{site.slogan}</span>
</Tag>
