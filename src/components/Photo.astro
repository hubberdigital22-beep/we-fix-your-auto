---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { photoQuality, photoWidths, tallImage } from '../lib/images';

interface Props {
	src: ImageMetadata;
	alt: string;
	sizes: string;
	widths?: number[];
	class?: string;
	eager?: boolean;
	position?: string;
	positionNarrow?: string;
	parallax?: boolean;
	quality?: number;
	tall?: { src: ImageMetadata; media: string; sizes: string };
}

const {
	src,
	alt,
	sizes,
	widths = photoWidths,
	class: className,
	eager = false,
	position,
	positionNarrow,
	parallax = false,
	quality = photoQuality,
	tall,
} = Astro.props;

const vars = [position && `--pos:${position}`, positionNarrow && `--pos-sm:${positionNarrow}`].filter(Boolean).join(';');
const tallSet = tall ? await tallImage(tall.src, quality) : null;
---

<div class:list={['photo', className]} data-photo={parallax ? '' : undefined} style={vars || undefined}>
	<picture>
		{tall && tallSet && <source media={tall.media} srcset={tallSet.srcSet.attribute} sizes={tall.sizes} type="image/webp" />}
		<Image
			src={src}
			alt={alt}
			width={1600}
			widths={widths}
			sizes={sizes}
			format="webp"
			quality={quality}
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
			decoding="async"
		/>
	</picture>
</div>
