---
import { site } from '../../config/site';
import { defaultLocale, htmlLangs, locales, type Locale } from '../../i18n/locales';
import { serializeSchema } from '../../lib/schema';
import { absoluteUrl } from '../../lib/url';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	path?: string;
	alternates?: Record<Locale, string>;
	image: { path: string; width: number; height: number; alt?: string };
	schema?: object;
	themeColor: string;
	noindex?: boolean;
}

const { title, description, locale, path, alternates, image, schema, themeColor, noindex = false } = Astro.props;

const robots =
	site.indexable && !noindex
		? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
		: 'noindex, nofollow';
const ogLocale = (value: Locale) => htmlLangs[value].replace('-', '_');
const otherLocales = locales.filter((value) => value !== locale);
const canonical = path ? absoluteUrl(path) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="theme-color" content={themeColor} />
{canonical && <link rel="canonical" href={canonical} />}
{alternates && locales.map((value) => <link rel="alternate" hreflang={value} href={absoluteUrl(alternates[value])} />)}
{alternates && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[defaultLocale])} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={ogLocale(locale)} />
{otherLocales.map((value) => <meta property="og:locale:alternate" content={ogLocale(value)} />)}
<meta property="og:image" content={absoluteUrl(image.path)} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
{image.alt && <meta property="og:image:alt" content={image.alt} />}
<meta name="twitter:card" content="summary_large_image" />
{image.alt && <meta name="twitter:image:alt" content={image.alt} />}
{schema && <script type="application/ld+json" set:html={serializeSchema(schema)} />}
